build Game_Mathematics.exe: CXX_EXECUTABLE_LINKER__Game_Mathematics_Debug CMakeFiles/Game_Mathematics.dir/main.cpp.obj CMakeFiles/Game_Mathematics.dir/01.Character_movement-1(using_vector_and_physics).cpp.obj CMakeFiles/Game_Mathematics.dir/02.Character_movement-2_(between_two_individual_vectors).cpp.obj CMakeFiles/Game_Mathematics.dir/03.Character_movement-3(Distance_between_the_two_character_in_vector).cpp.obj CMakeFiles/Game_Mathematics.dir/04._Distance_Comparison.cpp.obj CMakeFiles/Game_Mathematics.dir/05._Character_Movement-4(Vector_Scaling).cpp.obj CMakeFiles/Game_Mathematics.dir/06.Character_movement-5(Unit-Length_Vectors).cpp.obj CMakeFiles/Game_Mathematics.dir/07.Character_movement-6(Adding_Vector).cpp.obj CMakeFiles/Game_Mathematics.dir/09._-_10_Backstabbing_(Dot_Product).cpp.obj CMakeFiles/Game_Mathematics.dir/11.Jumping_and_Gravity_(Time_Delta,_Game_Loop).cpp.obj CMakeFiles/Game_Mathematics.dir/12.Smooth_Move(ment)_(Linear_Interpolation).cpp.obj CMakeFiles/Game_Mathematics.dir/13.Mouse_Control_(Euler_Angles).cpp.obj CMakeFiles/Game_Mathematics.dir/14.Character_Movement_7_(Cross_Product).cpp.obj CMakeFiles/Game_Mathematics.dir/15-16.Bullet_Collision_(Vector-AABB_Intersection).cpp.obj CMakeFiles/Game_Mathematics.dir/17._Explosions!_(The_Remap_Function).cpp.obj CMakeFiles/Game_Mathematics.dir/19._Billboarding_(Basis_Vectors).cpp.obj CMakeFiles/Game_Mathematics.dir/20._Character_Movement_8_(Matrices).cpp.obj CMakeFiles/Game_Mathematics.dir/21._Big_Boss_Enemy_(Matrix_Scaling).cpp.obj CMakeFiles/Game_Mathematics.dir/22.Rotating_Characters_(Matrix_Rotation).cpp.obj CMakeFiles/Game_Mathematics.dir/23.Character_Movement_9_(Matrix_Translation).cpp.obj CMakeFiles/Game_Mathematics.dir/24.Prop_Positioning_(TRS_Matrices).cpp.obj CMakeFiles/Game_Mathematics.dir/25-26.Updated_Bullet_Collisions_1-2_(Coordinate_Systems).cpp.obj CMakeFiles/Game_Mathematics.dir/27.Bullet_Collision_Part_3_(Line-Plane_Intersection).cpp.obj CMakeFiles/Game_Mathematics.dir/28.Adding_and_Removing_Character_(Entity_List).cpp.obj CMakeFiles/Game_Mathematics.dir/29.Frustum_Culling.cpp.obj CMakeFiles/Game_Mathematics.dir/30.Drawing_Transparent_Character_{Mergesort}.cpp.obj CMakeFiles/Game_Mathematics.dir/31.Axis-Angle_Rotation.cpp.obj CMakeFiles/Game_Mathematics.dir/32.Rotation_Quaternions.cpp.obj CMakeFiles/Game_Mathematics.dir/33.Quaternion_Inverse.cpp.obj CMakeFiles/Game_Mathematics.dir/34.Multiplying_Quaternion_-_35.Quaternion_and_Vectors.cpp.obj CMakeFiles/Game_Mathematics.dir/36.Slerping_Quaternions_-_37.Quaternion_Wrapup_and_Review.cpp.obj CMakeFiles/Game_Mathematics.dir/38.Faster_Matrix_Inversions.cpp.obj CMakeFiles/Game_Mathematics.dir/39.The_Camera_View_Transform_Matrix.cpp.obj CMakeFiles/Game_Mathematics.dir/40.Matrix_Transformations_(Merry-Go-Round).cpp.obj CMakeFiles/Game_Mathematics.dir/41.Move_Parents.cpp.obj CMakeFiles/Game_Mathematics.dir/42.Homogenous_Coordinates.cpp.obj CMakeFiles/Game_Mathematics.dir/43.Prespective_Matrix_-_44.Damage_Indicators.cpp.obj
  CONFIG = Debug
  FLAGS = -g
  LINK_LIBRARIES = -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32
  OBJECT_DIR = CMakeFiles\Game_Mathematics.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = Game_Mathematics.exe
  TARGET_IMPLIB = libGame_Mathematics.dll.a
  TARGET_PDB = Game_Mathematics.exe.dbg


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "E:\Game Mathematics\cmake-build-debug" && "E:\Jetbrains\Clion\CLion 2024.1.3\bin\cmake\win\x64\bin\cmake.exe" -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D "E:\Game Mathematics\cmake-build-debug" && "E:\Jetbrains\Clion\CLion 2024.1.3\bin\cmake\win\x64\bin\cmake.exe" --regenerate-during-build -S"E:\Game Mathematics" -B"E:\Game Mathematics\cmake-build-debug""
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

